    <mxCell id="211" value="Sin modificar datos" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#555;" vertex="1" parent="210">
      <mxGeometry y="55" width="340" height="25" as="geometry" />
    </mxCell>
    <mxCell id="212" value="1. Identificar todos los&#xa;   contract_id huérfanos distintos&#xa;&#xa;2. Calcular monto total afectado&#xa;&#xa;3. Verificar si los contratos&#xa;   existen como eliminados&#xa;   (deleted_at, otra tabla)&#xa;&#xa;4. Exportar listado para&#xa;   revisión del contador&#xa;&#xa;— SQL —&#xa;SELECT contract_id,&#xa;  COUNT(*) cuotas,&#xa;  SUM(amount) total&#xa;FROM payment_schedules ps&#xa;LEFT JOIN contracts c&#xa;  ON c.id = ps.contract_id&#xa;WHERE c.id IS NULL&#xa;GROUP BY ps.contract_id;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;" vertex="1" parent="210">
      <mxGeometry y="80" width="340" height="290" as="geometry" />
    </mxCell>

    <!-- FASE 2 -->
