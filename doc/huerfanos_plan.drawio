    <!-- FASE 1 -->
    <mxCell id="210" value="FASE 1&#xa;Diagnóstico" style="swimlane;startSize=55;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
