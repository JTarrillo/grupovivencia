    <mxCell id="227" value="Solo si son datos de prueba/migración.&#xa;Requiere validación contable.&#xa;Irreversible sin backup.&#xa;&#xa;✅ Backup existe:&#xa;backups/backup_20260425_114254/" style="text;html=1;align=left;verticalAlign=top;spacingLeft=15;fontSize=11;" vertex="1" parent="220">
      <mxGeometry y="275" width="360" height="100" as="geometry" />
    </mxCell>

    <!-- FASE 3 -->
    <mxCell id="230" value="FASE 3&#xa;Prevención Futura" style="swimlane;startSize=55;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
      <mxGeometry x="900" y="500" width="380" height="380" as="geometry" />
    </mxCell>
    <mxCell id="231" value="Cambios estructurales en BD" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#555;" vertex="1" parent="230">
      <mxGeometry y="55" width="380" height="25" as="geometry" />
    </mxCell>
    <mxCell id="232" value="1. Agregar FK constraint:&#xa;&#xa;ALTER TABLE payment_schedules&#xa;ADD CONSTRAINT fk_ps_contract&#xa;FOREIGN KEY (contract_id)&#xa;REFERENCES contracts(id)&#xa;ON DELETE CASCADE&#xa;ON UPDATE CASCADE;&#xa;&#xa;2. Agregar deleted_at en contracts&#xa;   para soft-delete seguro&#xa;&#xa;3. Índice en contract_id para&#xa;   performance en JOINs&#xa;&#xa;4. Script de integridad mensual:&#xa;   verificar LEFT JOIN IS NULL&#xa;   y alertar si hay huérfanos" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;" vertex="1" parent="230">
      <mxGeometry y="80" width="380" height="295" as="geometry" />
    </mxCell>

